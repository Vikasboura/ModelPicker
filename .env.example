# ModelPicker Configuration

# Public Cloud Demo Mode (Serverless / Groq Free Tier)
# Add PUBLIC_PROVIDER_API_KEY only in Vercel Project Settings > Environment Variables
PUBLIC_PROVIDER_API_KEY=
PUBLIC_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
PUBLIC_PROVIDER_MODEL=llama-3.1-8b-instant

# Local / Self-Hosted Mode (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
MODEL_PROVIDER=ollama

# Database (Local Mode)
DATABASE_URL=sqlite:///./data/modelpicker.db

# Evaluation & Scoring
JUDGE_MODEL=
QUALITY_WEIGHT=0.5
LATENCY_WEIGHT=0.3
COST_WEIGHT=0.2

# Concurrency & Warmup
MAX_CONCURRENT_REQUESTS=2
WARMUP_REQUESTS=1

# Backend Settings
APP_ENV=development
LOG_LEVEL=INFO
PRICING_FILE_PATH=./data/pricing.yaml
CORS_ORIGINS=http://localhost:5173,https://modelpicker.vikasboura.dev

# Frontend Settings (for frontend/.env)
VITE_API_URL=http://localhost:8000
